				combat.append("★★ %s ★★" % match_result_text)
			combat.append("红队 发射%d 命中%d (%.1f%%)" % [red_shots, red_hits, red_rate])
			combat.append("蓝队 发射%d 命中%d (%.1f%%)" % [blue_shots, blue_hits, blue_rate])
			combat.append("全场 发射%d 命中%d (%.1f%%)" % [total_shots, total_hits, total_rate])
			combat_hud_label.text = "\n".join(combat)
			combat_hud_label.position = Vector2(12, maxf(280.0, vp_size.y - 400.0))
		combat_hud_label.size = Vector2(440, 400)



func _fire_projectile(robot: Dictionary) -> void:
	var pitch_axis: Node3D = robot["pitch_axis"]
	var body: Node3D = robot["body"]
	var projectile := Node3D.new()
	projectile.set_script(ProjectileScript)
	add_child(projectile)
	# Spawn at nose/muzzle: body forward only (same for red and blue).
	var direction := _body_forward_dir(robot)
	var origin: Vector3 = body.global_position + Vector3(0.0, 0.32, 0.0) + direction * 0.48
	# Hard guard: never fire toward a same-team robot on the bore (AI + manual).
	var line_enemy: Variant = _find_enemy_on_muzzle_line(robot)
	if not bool(robot.get("is_player", false)) or not manual_control_mode:
		# AI shots must have a visible enemy on line.
		if line_enemy == null:
			projectile.queue_free()
			return
	if projectile.has_method("setup_team"):
		projectile.setup_team(origin, direction, bullet_speed, int(robot["team"]), int(robot["id"]))
	else:
		projectile.setup(origin, direction, bullet_speed)
	var rid: int = int(robot["id"])
	var shot_dir: Vector3 = direction
	projectile.resolved.connect(func(hit: bool, victim_id: int = -1):
		if not hit:
			return
		# Shooter score
		for r in robots:
			if int(r["id"]) == rid:
				r["hits"] = int(r["hits"]) + 1
				print("HIT robot=", rid, " total_hits=", r["hits"], " victim=", victim_id)
				break
		# Victim must scramble immediately to avoid the next shell.
		if victim_id >= 0:
			for r2 in robots:
				if int(r2["id"]) == victim_id:
					_on_robot_armor_hit(r2, shot_dir)
					break
	)
	robot["shots"] = int(robot["shots"]) + 1


func _input(event: InputEvent) -> void:
	# Overview: 左键平移 | 右键旋转 | 滚轮/中键缩放 | Tab 俯视全场
	if overview_mode and not config_panel.visible:
		if event is InputEventMouseButton:
			var mb := event as InputEventMouseButton
			if mb.button_index == MOUSE_BUTTON_LEFT:
				orbit_pan_dragging = mb.pressed
				orbit_dragging = mb.pressed or orbit_rot_dragging
				if mb.pressed:
					orbit_last_mouse = mb.position
				get_viewport().set_input_as_handled()
				return
			if mb.button_index == MOUSE_BUTTON_RIGHT:
				orbit_rot_dragging = mb.pressed
				orbit_dragging = mb.pressed or orbit_pan_dragging
				if mb.pressed:
					orbit_last_mouse = mb.position
				get_viewport().set_input_as_handled()
				return
			if mb.button_index == MOUSE_BUTTON_MIDDLE:
				orbit_dragging = mb.pressed
				if mb.pressed:
					orbit_last_mouse = mb.position
				get_viewport().set_input_as_handled()
				return
			if mb.button_index == MOUSE_BUTTON_WHEEL_UP and mb.pressed:
				orbit_distance = maxf(orbit_min_distance, orbit_distance / orbit_zoom_step - orbit_zoom_linear)
				_apply_orbit_camera()
				get_viewport().set_input_as_handled()
				return
			if mb.button_index == MOUSE_BUTTON_WHEEL_DOWN and mb.pressed:
				orbit_distance = minf(orbit_max_distance, orbit_distance * orbit_zoom_step + orbit_zoom_linear)
				_apply_orbit_camera()
				get_viewport().set_input_as_handled()
				return
		if event is InputEventMouseMotion and orbit_dragging:
			var mm := event as InputEventMouseMotion
			var delta: Vector2 = mm.position - orbit_last_mouse
			if delta.length_squared() < 1e-6:
				delta = mm.relative
			orbit_last_mouse = mm.position
			if orbit_pan_dragging:
				var right := Vector3(cos(orbit_yaw), 0.0, -sin(orbit_yaw))
				var fwd := Vector3(sin(orbit_yaw), 0.0, cos(orbit_yaw))
				var scale := orbit_pan_sensitivity * maxf(orbit_distance, 4.0)
				orbit_focus -= right * delta.x * scale
				orbit_focus += fwd * delta.y * scale
				orbit_focus.x = clampf(orbit_focus.x, -FIELD_HALF, FIELD_HALF)
				orbit_focus.z = clampf(orbit_focus.z, -FIELD_HALF, FIELD_HALF)
				orbit_focus.y = 0.0
			elif orbit_rot_dragging:
				orbit_yaw -= delta.x * orbit_sensitivity
				orbit_pitch -= delta.y * orbit_sensitivity
			else:
				orbit_distance = clampf(orbit_distance + delta.y * 0.05, orbit_min_distance, orbit_max_distance)
			_apply_orbit_camera()
			get_viewport().set_input_as_handled()
			return
		return

	if config_panel.visible:
		return

	var player: Dictionary = robots[player_robot_id]
	if event is InputEventMouseMotion and gameplay_controls_enabled:
		if not bool(player["auto_aim_enabled"]):
			player["manual_yaw_target"] = wrapf(
				float(player["manual_yaw_target"]) - event.relative.x * mouse_sensitivity, -PI, PI)
			player["manual_pitch_target"] = clampf(
				float(player["manual_pitch_target"]) - event.relative.y * mouse_sensitivity, -0.65, 0.65)
			get_viewport().set_input_as_handled()
			return
	if event is InputEventMouseButton:
		if event.button_index == MOUSE_BUTTON_RIGHT and gameplay_controls_enabled and \
			Input.mouse_mode == Input.MOUSE_MODE_CAPTURED:
			player["auto_aim_enabled"] = event.pressed
			if not event.pressed:
				player["manual_yaw_target"] = _gimbal_world_yaw(player)
				player["manual_pitch_target"] = player["pitch_axis"].rotation.x
			get_viewport().set_input_as_handled()
		elif event.button_index == MOUSE_BUTTON_LEFT:
			# LMB fires only in first-person manual control (overview LMB = orbit).
			if manual_control_mode and not overview_mode:
				if event.pressed and Input.mouse_mode != Input.MOUSE_MODE_CAPTURED:
					Input.mouse_mode = Input.MOUSE_MODE_CAPTURED
					gameplay_controls_enabled = true
				player["manual_fire_pressed"] = event.pressed and gameplay_controls_enabled
				get_viewport().set_input_as_handled()



func _unhandled_key_input(event: InputEvent) -> void:
	if not event is InputEventKey or event.echo:
		return
	var key_ev := event as InputEventKey
	# Space / J: hold to fire in manual mode (press + release)
	if key_ev.keycode == KEY_SPACE or key_ev.keycode == KEY_J:
		if manual_control_mode and not robots.is_empty():
			robots[player_robot_id]["manual_fire_pressed"] = key_ev.pressed and not config_panel.visible
			get_viewport().set_input_as_handled()
		return
	if not key_ev.pressed:
		return
	match key_ev.keycode:
		KEY_T:
			# Toggle AUTO (all AI fire) <-> MANUAL (selected car drive/fire)
			_set_manual_control_mode(not manual_control_mode)
			get_viewport().set_input_as_handled()
		KEY_TAB:
			# Top-down full arena overview.
			overview_mode = true
			orbit_dragging = false
			orbit_pan_dragging = false
			orbit_rot_dragging = false
			if not manual_control_mode:
				gameplay_controls_enabled = false
			Input.mouse_mode = Input.MOUSE_MODE_VISIBLE
			_orbit_focus_field()
			_set_active_camera()
		KEY_G:
			# First-person drive / aim mode (forces manual control)
			if not manual_control_mode:
				_set_manual_control_mode(true)
			overview_mode = false
			orbit_dragging = false
			gameplay_controls_enabled = true
			Input.mouse_mode = Input.MOUSE_MODE_CAPTURED
			_set_active_camera()
		KEY_F:
			if overview_mode:
				_orbit_focus_on_player()
			else:
				overview_mode = true
				if not manual_control_mode:
					gameplay_controls_enabled = false
				Input.mouse_mode = Input.MOUSE_MODE_VISIBLE
				_set_active_camera()
		KEY_H:
			overview_mode = true
			orbit_dragging = false
			if not manual_control_mode:
				gameplay_controls_enabled = false
			Input.mouse_mode = Input.MOUSE_MODE_VISIBLE
			_orbit_focus_field()
			overview_camera.current = true
			player_camera.current = false
		KEY_C:
			config_panel.visible = not config_panel.visible
			Input.mouse_mode = Input.MOUSE_MODE_VISIBLE if config_panel.visible or overview_mode \
				else Input.MOUSE_MODE_CAPTURED
		KEY_ESCAPE:
			# Exit manual control back to full auto
			if manual_control_mode:
				_set_manual_control_mode(false)
			gameplay_controls_enabled = false if not manual_control_mode else true
			Input.mouse_mode = Input.MOUSE_MODE_VISIBLE
			if not robots.is_empty():
				robots[player_robot_id]["manual_fire_pressed"] = false
		KEY_R:
			_reset_simulation()
		KEY_V:
			_dump_verification()
		KEY_1, KEY_2, KEY_3, KEY_4, KEY_5, KEY_6:
			# 1-3 red, 4-6 blue  => robot ids 0..5
			var new_id: int = int(key_ev.keycode) - int(KEY_1)
			if new_id >= 0 and new_id < ROBOT_COUNT:
				_set_player_robot(new_id)
				# Selecting a car while in auto mode only focuses; press T to take over.
		KEY_Q:
			if manual_control_mode and gameplay_controls_enabled:
				var p: Dictionary = robots[player_robot_id]
				p["chassis_gyro_direction"] = GYRO_DISABLED \
					if int(p["chassis_gyro_direction"]) == GYRO_COUNTERCLOCKWISE \
					else GYRO_COUNTERCLOCKWISE
		KEY_E:
			if manual_control_mode and gameplay_controls_enabled:
				var p2: Dictionary = robots[player_robot_id]
				p2["chassis_gyro_direction"] = GYRO_DISABLED \
					if int(p2["chassis_gyro_direction"]) == GYRO_CLOCKWISE \
					else GYRO_CLOCKWISE


func _robot_label(robot: Dictionary) -> String:
	var team_tag := "红" if int(robot["team"]) == TEAM_RED else "蓝"
	return "%s%d" % [team_tag, int(robot.get("number", 1))]


func _set_manual_control_mode(enabled: bool) -> void:
	manual_control_mode = enabled
	if enabled:
		# Take over currently focused robot; others stay full AI.
		auto_fire_all = true  # other robots keep auto-firing
		gameplay_controls_enabled = true
		for r in robots:
			var rid := int(r["id"])
			var take := rid == player_robot_id
			r["is_player"] = take
			r["auto_aim_enabled"] = true  # aim assist remains on
			r["manual_fire_pressed"] = false
			if not take:
				r["chassis_gyro_direction"] = GYRO_DISABLED
		print("CONTROL: MANUAL on ", _robot_label(robots[player_robot_id]),
			"  (WASD move, Space/J fire, 1-6 select, T back to auto)")
	else:
		# All six fully autonomous again.
		auto_fire_all = true
		ai_enabled = true
		for r in robots:
			r["is_player"] = int(r["id"]) == player_robot_id  # focus mark only
			r["auto_aim_enabled"] = true
			r["manual_fire_pressed"] = false
			r["chassis_gyro_direction"] = GYRO_DISABLED
		print("CONTROL: AUTO — all 6 robots move/aim/fire autonomously (T for manual)")
	if autofire_check != null:
		autofire_check.set_pressed_no_signal(auto_fire_all)
	if ai_check != null:
		ai_check.set_pressed_no_signal(ai_enabled)
	_attach_player_camera()
	_orbit_focus_on_player()


func _attach_player_camera() -> void:
	if player_camera == null or robots.is_empty():
		return
	if player_camera.get_parent() != null:
		player_camera.get_parent().remove_child(player_camera)
	var neu: Dictionary = robots[player_robot_id]
	neu["pitch_axis"].add_child(player_camera)
	_set_active_camera()


func _set_player_robot(new_id: int) -> void:
	if new_id < 0 or new_id >= robots.size():
		return
	if new_id == player_robot_id and bool(robots[new_id].get("is_player", false)):
		# Still refresh camera focus
		_orbit_focus_on_player()
		return
	# Clear previous selection
	for r in robots:
		r["is_player"] = false
		r["manual_fire_pressed"] = false
		if not manual_control_mode:
			r["auto_aim_enabled"] = true
	player_robot_id = new_id
	var neu: Dictionary = robots[player_robot_id]
	neu["is_player"] = true
	neu["auto_aim_enabled"] = true
	neu["manual_yaw_target"] = _gimbal_world_yaw(neu)
	neu["manual_pitch_target"] = neu["pitch_axis"].rotation.x
	if manual_control_mode:
		gameplay_controls_enabled = true
		print("CONTROL: selected ", _robot_label(neu), " for manual drive/fire")
	else:
		print("FOCUS: ", _robot_label(neu), " (still AUTO — press T for manual)")
	_attach_player_camera()
	_orbit_focus_on_player()


func _reset_simulation() -> void:
	## Full match reset: pose, HP, collisions, AI state, FX; destroyed cars respawn.
	manual_control_mode = false
	auto_fire_all = true
	ai_enabled = true
	gameplay_controls_enabled = false
	overview_mode = true
	for projectile in get_tree().get_nodes_in_group("sim_projectile"):
		if is_instance_valid(projectile):
			projectile.queue_free()
	for fx in get_tree().get_nodes_in_group("armor_hit_fx"):
		if is_instance_valid(fx):
			fx.queue_free()
	sim_time = 0.0
	match_over = false
	match_winner = -1
	match_result_text = ""
	capture_accumulator = 0.0
	capture_requested_id = -1
	capture_cursor = 0
	pending_captures.clear()
	hud_accum = 0.0
	for i in range(robots.size()):
		var robot: Dictionary = robots[i]
		var spawn: Dictionary = SPAWN_POSES[i]
		var body: CharacterBody3D = robot["body"]
		var spos: Vector3 = spawn["pos"]
		var steam: int = int(spawn["team"])
		# Respawn eliminated vehicles
		body.collision_layer = 1
		body.collision_mask = 1
		body.velocity = Vector3.ZERO
		body.global_position = Vector3(spos.x, 0.0, spos.z)
		if robot.has("assembly") and robot["assembly"] != null:
			robot["assembly"].rotation = Vector3.ZERO
			robot["assembly"].visible = true
		body.visible = true
		_face_enemy_camp(body, steam)
		var vr2: Node3D = null
		if robot.has("assembly"):
			vr2 = robot["assembly"].get_node_or_null("ChassisVisual") as Node3D
		if vr2 != null:
			_apply_mesh_yaw(vr2, CHASSIS_VISUAL_YAW_OFFSET)
		robot["yaw_axis"].rotation = Vector3.ZERO
		robot["pitch_axis"].rotation = Vector3.ZERO
		robot["command_yaw"] = body.rotation.y
		robot["command_pitch"] = 0.0
		robot["yaw_velocity"] = 0.0
		robot["pitch_velocity"] = 0.0
		robot["yaw_speed_integral"] = 0.0
		robot["pitch_speed_integral"] = 0.0
		robot["chassis_yaw_velocity"] = 0.0
		robot["chassis_gyro_direction"] = GYRO_DISABLED
		robot["manual_yaw_target"] = body.rotation.y
		robot["manual_pitch_target"] = 0.0
		robot["manual_fire_pressed"] = false
		robot["shoot_cooldown"] = 0.0
		robot["shots"] = 0
		robot["hits"] = 0
		robot["hit_taken"] = 0
		robot["alive"] = true
		robot["ai_mode"] = "hunt"
		robot["ai_duel_t"] = 0.0
		robot["ai_disengage_t"] = 0.0
		robot["ai_hit_evade_t"] = 0.0
		robot["ai_unstuck_t"] = 0.0
		robot["ai_stuck_time"] = 0.0
		robot["ai_camp_t"] = 0.0
		robot["ai_camp_anchor"] = body.global_position
		robot["ai_shots_burst"] = 0
		robot["ai_target_id"] = -1
		robot["ai_want_sprint"] = false
		robot["ai_speed_scale"] = 0.6
		robot["last_result_timestamp"] = -1
		robot["result_count"] = 0
		robot["detection_count"] = 0
		robot["control_count"] = 0
		robot["fusion_valid_count"] = 0
		robot["fusion_neighbor_count_max"] = 0
		robot["fusion_assist_count"] = 0
		robot["last_fusion_neighbors"] = 0
		robot["last_tracker_state"] = "reset"
		robot["auto_aim_enabled"] = true
		robot["is_player"] = int(robot["id"]) == player_robot_id
		var cr = robot.get("comm_root", null)
		if cr != null and is_instance_valid(cr):
			cr.visible = true
	if extension_ready and bridge != null:
		bridge.reset()
	_orbit_focus_field()
	_set_active_camera()
	Input.mouse_mode = Input.MOUSE_MODE_VISIBLE
	_update_hud()
	print("3v3 simulation FULL reset (all vehicles respawned)")


func _dump_verification() -> void:
	var report := {
		"extension_ready": extension_ready,
		"sim_time": sim_time,
		"camera_hz": camera_hz,
		"camera_size": [camera_size.x, camera_size.y],
		"robots": [],
	}
	if extension_ready and bridge != null:
		report["runtime_stats"] = bridge.get_runtime_stats()
	for robot in robots:
		report["robots"].append({
			"id": robot["id"],
			"team": robot["team"],
			"results": robot["result_count"],
			"detections": robot["detection_count"],
			"controls": robot["control_count"],
			"fusion_valid": robot.get("fusion_valid_count", 0),
			"fusion_neighbors_max": robot.get("fusion_neighbor_count_max", 0),
			"fusion_assist": robot.get("fusion_assist_count", 0),
			"armors": robot["last_armor_count"],
			"tracker": robot["last_tracker_state"],
			"hits": robot["hits"],
			"shots": robot["shots"],
		})
	var text := JSON.stringify(report, "  ")
	print("=== 3v3 VERIFICATION DUMP ===")
	print(text)
	var path := "user://3v3_verify.json"
	var f := FileAccess.open(path, FileAccess.WRITE)
	if f:
		f.store_string(text)
		f.close()
		print("Wrote ", ProjectSettings.globalize_path(path))
	if config_status_label:
		config_status_label.text = "Verification dumped (see console / user://3v3_verify.json)"


func get_verification_snapshot() -> Dictionary:
	## Used by automated tests.
	var robots_out: Array = []
	for robot in robots:
		robots_out.append({
			"id": robot["id"],
			"team": robot["team"],
			"results": robot["result_count"],
			"detections": robot["detection_count"],
			"controls": robot["control_count"],
			"fusion_valid": robot.get("fusion_valid_count", 0),
			"fusion_neighbors_max": robot.get("fusion_neighbor_count_max", 0),
			"fusion_assist": robot.get("fusion_assist_count", 0),
			"armors": robot["last_armor_count"],
			"tracker": robot["last_tracker_state"],
		})
	var snap := {
		"extension_ready": extension_ready,
		"sim_time": sim_time,
		"robots": robots_out,
	}
	if extension_ready and bridge != null:
		snap["runtime_stats"] = bridge.get_runtime_stats()
	return snap



func _instantiate_chassis_model() -> Node3D:
	## Always instantiate a fresh PackedScene copy (never mutate a shared template).
	if ResourceLoader.exists(CHASSIS_MODEL_PATH):
		var res: Resource = load(CHASSIS_MODEL_PATH)
		if res is PackedScene:
			var inst: Node = (res as PackedScene).instantiate()
			if inst is Node3D:
				return inst as Node3D
			if inst != null:
				var wrap := Node3D.new()
				wrap.add_child(inst)
				return wrap
	# Fallback path (runtime GLTF / cached template)
	if _chassis_model_template == null:
		_chassis_model_template = _load_chassis_model_template()
	if _chassis_model_template == null:
		return null
	return _chassis_model_template.duplicate() as Node3D


func _load_chassis_model_template() -> Node3D:
	## Prefer Godot-imported PackedScene; fall back to runtime GLTFDocument.
	if ResourceLoader.exists(CHASSIS_MODEL_PATH):
		var res: Resource = load(CHASSIS_MODEL_PATH)
		if res is PackedScene:
			var inst := (res as PackedScene).instantiate()
			if inst is Node3D:
				print("Chassis model loaded as PackedScene: ", CHASSIS_MODEL_PATH)
				return inst as Node3D
			if inst != null:
				var wrap := Node3D.new()
				wrap.add_child(inst)
				print("Chassis model wrapped non-Node3D root")
				return wrap
	# Runtime import (works even without editor .import cache).
	var abs_path := ProjectSettings.globalize_path(CHASSIS_MODEL_PATH)
	if not FileAccess.file_exists(CHASSIS_MODEL_PATH) and not FileAccess.file_exists(abs_path):
		push_error("Chassis GLB not found: " + CHASSIS_MODEL_PATH)
		return null
	var doc := GLTFDocument.new()
	var state := GLTFState.new()
	var err := doc.append_from_file(abs_path, state)
	if err != OK:
		push_error("GLTFDocument.append_from_file failed (%s): %s" % [str(err), abs_path])
		return null
	var generated: Node = doc.generate_scene(state)
	if generated == null:
		push_error("GLTFDocument.generate_scene returned null")
		return null
	if generated is Node3D:
		print("Chassis model loaded via GLTFDocument: ", abs_path)
		return generated as Node3D
	var holder := Node3D.new()
	holder.add_child(generated)
	print("Chassis model runtime-wrapped: ", abs_path)
	return holder



func _bind_glb_turret_to_gimbal(visual_root: Node3D, yaw_axis: Node3D, pitch_axis: Node3D) -> bool:
	## Sketchfab S1 export: node_id6 = upper gun turret, node_id57 = wheeled base.
	## Reparent turret under pitch_axis so aim commands rotate the real mesh.
	var turret: Node3D = _find_named_node3d(visual_root, "node_id6")
	if turret == null:
		# Some imports rename; fall back to second large child under mm-scale root.
		turret = _find_turret_fallback(visual_root)
	if turret == null:
		return false

	# Place gimbal pivot at current turret world position (base of gun assembly).
	var turret_gt: Transform3D = turret.global_transform
	var pivot_world: Vector3 = turret_gt.origin
	yaw_axis.global_position = Vector3(pivot_world.x, pivot_world.y, pivot_world.z)

	# Reparent preserving world transform.
	var old_parent: Node = turret.get_parent()
	if old_parent != null:
		old_parent.remove_child(turret)
	pitch_axis.add_child(turret)
	turret.global_transform = turret_gt

	print("Bound GLB turret '", turret.name, "' under pitch_axis at ", yaw_axis.position)
	return true


func _find_named_node3d(root: Node, exact_name: String) -> Node3D:
	var stack: Array = [root]
	while not stack.is_empty():
		var n: Node = stack.pop_back()
		for c in n.get_children():
			stack.append(c)
		if n is Node3D and n.name == exact_name:
			return n as Node3D
	return null


func _find_turret_fallback(visual_root: Node3D) -> Node3D:
	## Find mm-scale node (scale ~0.001) with >=2 children; return the 2nd (turret).
	var stack: Array = [visual_root]
	while not stack.is_empty():
		var n: Node = stack.pop_back()
		for c in n.get_children():
			stack.append(c)
		if not (n is Node3D):
			continue
		var nd := n as Node3D
		if nd.get_child_count() < 2:
			continue
		var s: Vector3 = nd.scale
		var is_micro := s.x > 0.0 and s.x < 0.01 and absf(s.x - s.y) < 1e-5
		if is_micro:
			var child1 = nd.get_child(1)
			if child1 is Node3D:
				return child1 as Node3D
	return null


func _apply_mesh_yaw(visual_root: Node3D, yaw: float) -> void:
	## Rotate the aligned GLB holder so the original chassis+turret turn as one.
	## Must run AFTER _align_chassis_model (which resets holder.rotation).
	var holder := visual_root.get_node_or_null("ChassisAligned") as Node3D
	if holder == null:
		# Fallback: yaw the visual root itself
		visual_root.rotation.y = yaw
		print("mesh yaw fallback on visual_root y=", yaw)
		return
	holder.rotation = Vector3(0.0, yaw, 0.0)
	print("mesh yaw on ChassisAligned y=", yaw)


func _align_chassis_model(model: Node3D, visual_root: Node3D) -> Vector3:
	## Put chassis geometric bottom-center at visual_root/assembly/body origin,
	## so mesh, armors and gimbal share one pivot and never desync on move/yaw.
	model.transform = Transform3D.IDENTITY
	# Keep FULL model (chassis + turret). node_id6 is the gun turret, not junk.
	# Only hide mesh islands that are extremely far after import.

	var aabb := _compute_node_aabb_global(model)
	if aabb.size.length() < 1e-5:
		push_warning("Chassis AABB empty")
		return CHASSIS_COLLISION_SIZE

	var horizontal := maxf(aabb.size.x, aabb.size.z)
	var fit: float = (CHASSIS_TARGET_LENGTH / horizontal) if horizontal > 1e-5 else 1.0
	fit *= CHASSIS_MODEL_SCALE
	_chassis_model_scale = fit

	var holder := Node3D.new()
	holder.name = "ChassisAligned"
	visual_root.add_child(holder)

	var center: Vector3 = aabb.get_center()
	var bottom_center := Vector3(center.x, aabb.position.y, center.z)

	# Reparent model under holder, keep current world pose.
	var model_gt: Transform3D = model.global_transform
	var old_parent: Node = model.get_parent()
	if old_parent != null:
		old_parent.remove_child(model)
	holder.add_child(model)
	model.global_transform = model_gt

	# Move holder origin to mesh bottom-center WITHOUT dragging the mesh:
	# set holder global pos, then restore model world pose.
	holder.global_position = bottom_center
	holder.global_rotation = Vector3.ZERO
	model.global_transform = model_gt

	# Scale about bottom-center pivot (holder origin).
	holder.scale = Vector3.ONE * fit

	# Snap pivot to visual_root / body origin (assembly center).
	holder.position = Vector3.ZERO
	holder.rotation = Vector3.ZERO

	_hide_distant_meshes(holder, CHASSIS_TARGET_LENGTH * 1.6)

	var final_aabb := _compute_node_aabb_global(holder)
	var size: Vector3 = final_aabb.size
	if size.x < 0.05 or size.y < 0.05 or size.z < 0.05:
		size = Vector3(
			CHASSIS_TARGET_LENGTH * 0.85,
			CHASSIS_TARGET_LENGTH * 0.45,
			CHASSIS_TARGET_LENGTH)
	print("Chassis aligned size=", size, " fit=", fit, " raw_aabb=", aabb.size)
	return size



func _compute_node_aabb_global(root: Node) -> AABB:
	var has_any := false
	var merged := AABB()
	var stack: Array = [root]
	while not stack.is_empty():
		var n: Node = stack.pop_back()
		for c in n.get_children():
			stack.append(c)
		if n is VisualInstance3D:
			var vi := n as VisualInstance3D
			if not vi.is_visible_in_tree() and vi != root:
				# still include if just not visible flag
				pass
			if not vi.visible:
				continue
			var local := vi.get_aabb()
			if local.size.length() <= 0.0:
				continue
			if not vi.is_inside_tree():
				continue
			var world_aabb := _xform_aabb(vi.global_transform, local)
			if not has_any:
				merged = world_aabb
				has_any = true
			else:
				merged = merged.merge(world_aabb)
	return merged if has_any else AABB()



func _hide_distant_meshes(root: Node3D, max_radius: float) -> void:
	var meshes: Array = []
	var stack: Array = [root]
	while not stack.is_empty():
		var n: Node = stack.pop_back()
		for c in n.get_children():
			stack.append(c)
		if n is MeshInstance3D:
			meshes.append(n)
	var hidden := 0
	for m in meshes:
		var mi := m as MeshInstance3D
		var xf := _relative_transform_to(root, mi)
		var local_aabb: AABB = mi.get_aabb()
		var center: Vector3 = xf * local_aabb.get_center()
		# Ignore vertical; only planar distance from chassis center.
		var planar := Vector2(center.x, center.z).length()
		if planar > max_radius:
			mi.visible = false
			hidden += 1
	if hidden > 0:
		print("Hidden ", hidden, " distant mesh islands on chassis")


func _prune_glb_to_single_chassis(model: Node3D) -> void:
	## Intentionally a no-op: both children under the Sketchfab mm-root are needed
	## (node_id57 = chassis/wheels, node_id6 = gun turret). Do not strip the turret.
	pass



func _compute_node_aabb(root: Node) -> AABB:
	var has_any := false
	var merged := AABB()
	var stack: Array = [root]
	while not stack.is_empty():
		var n: Node = stack.pop_back()
		for c in n.get_children():
			stack.append(c)
		if n is VisualInstance3D:
			var vi := n as VisualInstance3D
			var local := vi.get_aabb()
			if local.size.length() <= 0.0:
				continue
			var xf: Transform3D = vi.global_transform if vi.is_inside_tree() else vi.transform
			# If not in tree yet, accumulate in root-local space via relative xforms.
			if not vi.is_inside_tree():
				xf = _relative_transform_to(root, vi)
			var world_aabb := _xform_aabb(xf, local)
			if not has_any:
				merged = world_aabb
				has_any = true
			else:
				merged = merged.merge(world_aabb)
	return merged if has_any else AABB()


func _relative_transform_to(ancestor: Node, node: Node) -> Transform3D:
	var xf := Transform3D.IDENTITY
	var cur: Node = node
	var guard := 0
	while cur != null and cur != ancestor and guard < 64:
		if cur is Node3D:
			xf = (cur as Node3D).transform * xf
		cur = cur.get_parent()
		guard += 1
	return xf


func _xform_aabb(xf: Transform3D, aabb: AABB) -> AABB:
	var corners: Array[Vector3] = [
		aabb.position,
		aabb.position + Vector3(aabb.size.x, 0, 0),
		aabb.position + Vector3(0, aabb.size.y, 0),
		aabb.position + Vector3(0, 0, aabb.size.z),
		aabb.position + Vector3(aabb.size.x, aabb.size.y, 0),
		aabb.position + Vector3(aabb.size.x, 0, aabb.size.z),
		aabb.position + Vector3(0, aabb.size.y, aabb.size.z),
		aabb.position + aabb.size,
	]
	var out := AABB(xf * corners[0], Vector3.ZERO)
	for i in range(1, corners.size()):
		out = out.expand(xf * corners[i])
	return out


func _material(color: Color, roughness: float, emission := Color.BLACK, energy := 0.0) -> StandardMaterial3D:
	var material := StandardMaterial3D.new()
	material.albedo_color = color
	material.roughness = roughness
	if energy > 0.0:
		material.emission_enabled = true
		material.emission = emission
		material.emission_energy_multiplier = energy
	return material
