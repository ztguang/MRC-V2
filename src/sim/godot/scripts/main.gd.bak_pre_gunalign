func _add_spin_row(parent: Container, title: String, minimum: float, maximum: float,
		step: float, initial: float) -> SpinBox:
	var row := HBoxContainer.new()
	var label := Label.new()
	label.text = title
	label.custom_minimum_size = Vector2(110, 0)
	row.add_child(label)
	var spin := SpinBox.new()
	spin.min_value = minimum
	spin.max_value = maximum
	spin.step = step
	spin.value = initial
	spin.size_flags_horizontal = Control.SIZE_EXPAND_FILL
	row.add_child(spin)
	parent.add_child(row)
	return spin


func _initialize_extension() -> void:
	if not ClassDB.class_exists("AutoAimBridge"):
		hud_label.text = "3v3 VISION OFFLINE (no AutoAimBridge)"
		push_error("AutoAimBridge GDExtension class missing")
		return
	bridge = ClassDB.instantiate("AutoAimBridge")
	base_config_path = ProjectSettings.globalize_path("res://configs/sim.yaml")
	var runtime_resource := "res://configs/sim.runtime.yaml"
	runtime_config_path = ProjectSettings.globalize_path(runtime_resource) \
		if FileAccess.file_exists(runtime_resource) else ""
	var status: Dictionary
	# GUI debug window only for player robot to avoid OpenCV multi-window issues.
	if not runtime_config_path.is_empty() and bridge.has_method("initialize_with_runtime"):
		status = bridge.initialize_with_runtime(base_config_path, runtime_config_path, player_robot_id)
	else:
		status = bridge.initialize(base_config_path)
	extension_ready = bool(status.get("ok", false))
	if extension_ready:
		_apply_camera_config(status)
		if bullet_speed < 6.0 or bullet_speed > 20.0:
			bullet_speed = 10.0
		print("SIM FEEL: muzzle=", bullet_speed, " vision=", camera_size, " @", camera_hz, "Hz (queue-backed)")
	var msg := str(status.get("message", "unknown"))
	print("AutoAimBridge 3v3: ", msg, " max_robots=", status.get("max_robots", "?"))
	hud_label.text = "3v3 VISION ONLINE" if extension_ready else ("3v3 VISION OFFLINE: " + msg)



func _read_config_float(key: String, default_value: float) -> float:
	## Lightweight YAML scalar reader for sim.yaml / sim.runtime.yaml.
	var paths: Array = [
		ProjectSettings.globalize_path("res://configs/sim.yaml"),
		ProjectSettings.globalize_path("res://configs/sim.runtime.yaml"),
	]
	var found := default_value
	var re := RegEx.new()
	re.compile("^\\s*" + key + "\\s*:\\s*([-+0-9.eE]+)\\s*$")
	for path in paths:
		if path.is_empty() or not FileAccess.file_exists(path):
			continue
		var f := FileAccess.open(path, FileAccess.READ)
		if f == null:
			continue
		while not f.eof_reached():
			var line := f.get_line()
			var m := re.search(line)
			if m != null:
				found = float(m.get_string(1))
		f.close()
	return found


func _apply_camera_config(config: Dictionary) -> void:
	# Prefer lean defaults for multi-robot; YAML may request higher rates.
	var cfg_w := int(config.get("image_width", camera_size.x))
	var cfg_h := int(config.get("image_height", camera_size.y))
	if FileAccess.file_exists("res://configs/sim.runtime.yaml"):
		cfg_w = mini(cfg_w, 320)
		cfg_h = mini(cfg_h, 240)
	# Cap vision resolution for 6x SubViewport performance on GPU.
	camera_size = Vector2i(mini(cfg_w, 320), mini(cfg_h, 240))
	# Cap per-robot rate so total worker load stays realistic on CPU YOLO.
	camera_hz = clampf(float(config.get("camera_fps", camera_hz)), 1.0, 2.0)
	if camera_hz > 1.0:
		camera_hz = 1.0
	camera_fov = clampf(float(config.get("fov_degrees", camera_fov)), 1.0, 179.0)
	camera_exposure_multiplier = maxf(0.01, float(config.get("exposure_multiplier", camera_exposure_multiplier)))
	camera_gamma = maxf(0.01, float(config.get("gamma", camera_gamma)))
	# Slow readable shell (~10 m/s) for visible flight path.
	var yaml_bs := _read_config_float("bullet_speed", bullet_speed)
	var pick_bs := yaml_bs if yaml_bs > 1.0 else 10.0
	if pick_bs < 6.0 or pick_bs > 20.0:
		pick_bs = 10.0
	bullet_speed = clampf(pick_bs, 6.0, 20.0)
	planner_max_yaw_acc = maxf(1.0, float(config.get("max_yaw_acc", planner_max_yaw_acc)))
	planner_max_pitch_acc = maxf(1.0, float(config.get("max_pitch_acc", planner_max_pitch_acc)))
	auto_aim_yaw_velocity_feedforward = float(config.get(
		"auto_aim_yaw_velocity_feedforward", auto_aim_yaw_velocity_feedforward))
	auto_aim_yaw_acceleration_feedforward = float(config.get(
		"auto_aim_yaw_acceleration_feedforward", auto_aim_yaw_acceleration_feedforward))
	auto_aim_pitch_velocity_feedforward = float(config.get(
		"auto_aim_pitch_velocity_feedforward", auto_aim_pitch_velocity_feedforward))
	auto_aim_pitch_acceleration_feedforward = float(config.get(
		"auto_aim_pitch_acceleration_feedforward", auto_aim_pitch_acceleration_feedforward))
	if world_environment != null:
		world_environment.tonemap_exposure = maxf(0.01, float(config.get("tonemap_exposure", 1.0)))
		world_environment.ambient_light_energy = maxf(0.0, float(config.get("ambient_light_energy", 0.8)))
	if sun_light != null:
		sun_light.light_energy = maxf(0.0, float(config.get("sun_energy", 1.1)))
	for robot in robots:
		robot["viewport"].size = camera_size
		robot["sim_camera"].fov = camera_fov
	if player_camera != null:
		player_camera.fov = camera_fov
	if width_spin != null:
		width_spin.set_value_no_signal(camera_size.x)
		height_spin.set_value_no_signal(camera_size.y)
		fps_spin.set_value_no_signal(camera_hz)
	print("3v3 camera: %dx%d @ %.1f Hz/robot FOV %.1f muzzle %.1f" % [
		camera_size.x, camera_size.y, camera_hz, camera_fov, bullet_speed])


func _apply_runtime_panel() -> void:
	camera_size = Vector2i(int(width_spin.value), int(height_spin.value))
	camera_hz = clampf(fps_spin.value, 1.0, 15.0)
	auto_fire_all = autofire_check.button_pressed
	ai_enabled = ai_check.button_pressed
	for robot in robots:
		robot["viewport"].size = camera_size
	config_status_label.text = "Applied panel settings (no worker restart)"


func _physics_process(delta: float) -> void:
	sim_time += delta
	_check_match_timeout()
	_update_comm_signals(delta)
	if match_over:
		_update_hud()
		return
	for robot in robots:
		robot["shoot_cooldown"] = maxf(0.0, float(robot["shoot_cooldown"]) - delta)
		_update_robot_chassis(robot, delta)
		_update_robot_gimbal(robot, delta)
		_update_robot_sensor_transform(robot)
		var is_manual_player := manual_control_mode and bool(robot.get("is_player", false))
		# Manual fire (Space / LMB held)
		if is_manual_player and bool(robot["manual_fire_pressed"]) and float(robot["shoot_cooldown"]) <= 0.0:
			_fire_projectile(robot)
			robot["shoot_cooldown"] = 0.12
		# AI combat for everyone not under manual human control
		elif (not is_manual_player) and auto_fire_all and ai_enabled and bool(robot.get("alive", true)) and bool(robot.get("auto_aim_enabled", true)):
			# Hunt any enemy for movement; aim/fire only at VISIBLE enemies (clear LOS).
			var hunt: Variant = _nearest_enemy(robot)
			var foe: Variant = _pick_fire_opportunity(robot)  # visible only
			_update_ai_combat_mode(robot, delta, hunt if hunt != null else foe)
			var mode: String = str(robot.get("ai_mode", "hunt"))
			# Aim only at visible enemy (never teammate; never through walls).
			if foe != null and mode != "disengage" and _enemy_visible(robot, foe):
				var foe_pos: Vector3 = foe["body"].global_position + Vector3(0.0, 0.2, 0.0)
				var to_f: Vector3 = foe_pos - robot["body"].global_position
				to_f.y = 0.0
				if to_f.length() > 0.45 and to_f.length() < MUZZLE_LINE_RANGE_MAX:
					robot["command_yaw"] = _yaw_from_dir(to_f)
					robot["command_pitch"] = 0.0
			elif hunt != null and mode != "disengage":
				# No LOS yet: point toward hunt target while closing / peeking.
				var hp2: Vector3 = hunt["body"].global_position - robot["body"].global_position
				hp2.y = 0.0
				if hp2.length() > 0.5:
					robot["command_yaw"] = _yaw_from_dir(hp2)
					robot["command_pitch"] = 0.0
			# Fire ONLY with bore-sight + clear LOS (enforced in _can_ai_fire_now).
			var allow_fire := mode != "disengage" and float(robot.get("ai_hit_evade_t", 0.0)) <= 0.0
			if mode == "engage" and int(robot.get("ai_shots_burst", 0)) >= 4 + int(float(robot.get("ai_brave", 0.5)) * 2.0):
				allow_fire = false
				if float(robot["shoot_cooldown"]) < 0.3:
					robot["shoot_cooldown"] = 0.4 + randf() * 0.4
			if allow_fire and float(robot["shoot_cooldown"]) <= 0.0 and _can_ai_fire_now(robot):
				_fire_projectile(robot)
				robot["ai_shots_burst"] = int(robot.get("ai_shots_burst", 0)) + 1
				var cd := AI_SHOT_COOLDOWN * (0.85 + randf() * 0.4)
				robot["shoot_cooldown"] = cd
		# Manual player still gets auto-aim assist toward nearest enemy (fire stays manual)
		elif is_manual_player and bool(robot.get("auto_aim_enabled", true)):
			var foe2: Variant = _nearest_enemy(robot)
			if foe2 != null:
				var to_f2: Vector3 = foe2["body"].global_position - robot["body"].global_position
				to_f2.y = 0.0
				if to_f2.length() > 0.5:
					robot["command_yaw"] = _yaw_from_dir(to_f2)
					robot["command_pitch"] = 0.0

	if extension_ready:
		capture_accumulator += delta
		var period := 1.0 / maxf(camera_hz, 1.0)
		# Round-robin + global cap + queue backpressure (stops Tracker Large dt).
		var slot_period := period / float(ROBOT_COUNT)
		var min_slot := 0.5  # <=2 vision jobs/s total (GPU idle; CPU worker is bottleneck)
		if slot_period < min_slot:
			slot_period = min_slot
		if capture_accumulator >= slot_period and capture_requested_id < 0:
			var queue_depth := 0
			if bridge != null and bridge.has_method("get_runtime_stats"):
				var st: Dictionary = bridge.get_runtime_stats()
				queue_depth = int(st.get("queue_depth", 0))
			if queue_depth >= 1:
				capture_accumulator = 0.0  # drop slot, let worker drain
			else:
				capture_accumulator = fmod(capture_accumulator, slot_period)
				capture_requested_id = capture_cursor
				capture_cursor = (capture_cursor + 1) % ROBOT_COUNT
				robots[capture_requested_id]["viewport"].render_target_update_mode = SubViewport.UPDATE_ONCE
		_poll_all_results()
	hud_accum += delta
	if hud_accum >= 0.12:
		hud_accum = 0.0
		_update_hud()


func _update_robot_chassis(robot: Dictionary, delta: float) -> void:
	var body: CharacterBody3D = robot["body"]
	if not bool(robot.get("alive", true)):
		body.velocity = Vector3.ZERO
		return
	var yaw_axis: Node3D = robot["yaw_axis"]
	var is_player: bool = robot["is_player"]
	# In manual mode, allow WASD even in overview so you can drive while watching.
	var controls_enabled := (
		gameplay_controls_enabled
		and not config_panel.visible
		and (not overview_mode or manual_control_mode)
	)
	var player_driving := manual_control_mode and is_player and controls_enabled

	var right_input := 0.0
	var forward_input := 0.0
	var sprinting := false
	if player_driving:
		right_input = Input.get_axis(ACTION_MOVE_LEFT, ACTION_MOVE_RIGHT)
		forward_input = Input.get_axis(ACTION_MOVE_BACKWARD, ACTION_MOVE_FORWARD)
		sprinting = Input.is_action_pressed(ACTION_SPRINT) or Input.is_physical_key_pressed(KEY_SHIFT)
	elif ai_enabled and (not player_driving):
		# AI drive: tactics + variable throttle (turn slow / dodge fast).
		var drive: Vector2 = _compute_ai_drive(robot, delta)
		forward_input = drive.x
		right_input = drive.y
		sprinting = bool(robot.get("ai_want_sprint", false))

	# Drive basis: body forward for AI so muzzle/nose match travel (not crab/reverse).
	var forward: Vector3
	var right: Vector3
	if player_driving:
		forward = -yaw_axis.global_transform.basis.z
		forward.y = 0.0
		forward = forward.normalized()
		right = yaw_axis.global_transform.basis.x
		right.y = 0.0
		right = right.normalized()
	else:
		forward = _body_forward_dir(robot)
		right = Vector3.UP.cross(forward)
		if right.length_squared() < 1e-6:
			right = Vector3.RIGHT
		else:
			right = right.normalized()
	# Obstacle / peer avoidance (AI and manual)
	var avoid := _avoidance_bias(body, forward, right)
	right_input = clampf(right_input + avoid.x, -1.0, 1.0)
	forward_input *= avoid.y
	if avoid.y < 0.35 and absf(avoid.x) > 0.05:
		# Prefer slide along obstacle instead of stalling
		right_input = clampf(right_input + signf(avoid.x) * 0.55, -1.0, 1.0)
	if avoid.z > 0.5 and forward_input >= 0.0 and float(robot.get("ai_unstuck_t", 0.0)) <= 0.0:
		_begin_unstuck(robot, body, forward, right)
	var unstuck_drive: Vector2 = _apply_unstuck(robot, body, forward, right, forward_input, right_input, delta)
	forward_input = unstuck_drive.x
	right_input = unstuck_drive.y
	# AI: forward-only outside brief unstuck. Face aim BEFORE throttle.
	# This stops "reverse toward target" when body nose was wrong (esp. blue).
	if not player_driving and float(robot.get("ai_unstuck_t", 0.0)) <= 0.0:
		forward_input = clampf(forward_input, 0.0, 1.0)
		right_input = clampf(right_input, -1.0, 1.0)
		var aim_y := float(robot.get("command_yaw", body.rotation.y))
		var face_err := wrapf(aim_y - body.rotation.y, -PI, PI)
		if absf(face_err) > 0.55:
			# Turn in place toward aim; tiny creep only — never reverse to "fix" aim.
			forward_input = minf(forward_input, 0.08)
			if absf(right_input) < 0.35:
				right_input = signf(face_err) if absf(face_err) > 1e-4 else float(robot.get("ai_orbit_dir", 1.0))
				right_input = clampf(right_input, -1.0, 1.0) * 0.95
	# Map AI speed_scale ∈ [0,1] across turn → cruise → combat → sprint.
	var speed_scale := 1.0 if player_driving else float(robot.get("ai_speed_scale", 0.55))
	speed_scale = clampf(speed_scale, 0.0, 1.0)
	var max_speed: float
	if player_driving:
		max_speed = CHASSIS_BURST_SPEED if sprinting else CHASSIS_NORMAL_SPEED
	else:
		if sprinting or speed_scale > 0.85:
			max_speed = lerpf(CHASSIS_COMBAT_SPEED, CHASSIS_BURST_SPEED, clampf((speed_scale - 0.85) / 0.15, 0.0, 1.0))
		elif speed_scale < 0.35:
			# Turning / tight maneuver
			max_speed = lerpf(CHASSIS_TURN_SPEED, CHASSIS_NORMAL_SPEED, speed_scale / 0.35)
		elif speed_scale < 0.65:
			max_speed = lerpf(CHASSIS_NORMAL_SPEED, CHASSIS_COMBAT_SPEED, (speed_scale - 0.35) / 0.30)
		else:
			max_speed = lerpf(CHASSIS_COMBAT_SPEED, CHASSIS_BURST_SPEED, (speed_scale - 0.65) / 0.35)
	var max_omega := CHASSIS_BURST_OMEGA if (sprinting or speed_scale > 0.8) else CHASSIS_NORMAL_OMEGA
	# Slow yaw while turning hard at low speed_scale
	if not player_driving and absf(right_input) > 0.55 and absf(forward_input) < 0.45:
		max_speed = minf(max_speed, CHASSIS_TURN_SPEED * 1.25)
		max_omega = CHASSIS_NORMAL_OMEGA * 0.85
	var current_planar := Vector3(body.velocity.x, 0.0, body.velocity.z)
	var ai_rev_ok := (not player_driving) and float(robot.get("ai_unstuck_t", 0.0)) > 0.0
	var fwd_cmd := forward_input
	if not player_driving and not ai_rev_ok:
		fwd_cmd = maxf(fwd_cmd, 0.0)
	var planned_forward := _approach_speed(current_planar.dot(forward), fwd_cmd * max_speed, 10.0, 12.0, delta)
	var planned_right := _approach_speed(current_planar.dot(right), right_input * max_speed, 11.0, 13.0, delta)
	if not player_driving and not ai_rev_ok and planned_forward < 0.0:
		planned_forward = 0.0

	var desired_omega := 0.0
	var gyro: int = robot["chassis_gyro_direction"]
	if gyro != GYRO_DISABLED:
		desired_omega = gyro * max_omega
	elif not player_driving:
		# Face command_yaw ONLY (enemy). Identical red/blue via _yaw_from_dir / atan2.
		# Do NOT blend move direction — that made blue crab/spin with nose off target.
		var aim_yaw2 := float(robot.get("command_yaw", body.rotation.y))
		var yaw_err2 := wrapf(aim_yaw2 - body.rotation.y, -PI, PI)
		desired_omega = clampf(yaw_err2 * 6.5, -max_omega, max_omega)
	else:
		var relative_gimbal_yaw2 := wrapf(yaw_axis.rotation.y, -PI, PI)
		if absf(relative_gimbal_yaw2) > CHASSIS_FOLLOW_DEADZONE:
			desired_omega = clampf(relative_gimbal_yaw2 * CHASSIS_FOLLOW_KP, -CHASSIS_NORMAL_OMEGA, CHASSIS_NORMAL_OMEGA)
	robot["chassis_yaw_velocity"] = move_toward(
		float(robot["chassis_yaw_velocity"]), desired_omega, CHASSIS_ANGULAR_ACCEL * delta)

	var chassis_yaw_velocity: float = robot["chassis_yaw_velocity"]
	var planned_left := -planned_right
	var chassis_forward: float
	var chassis_left: float
	if player_driving:
		var relative_yaw := wrapf(yaw_axis.rotation.y, -PI, PI)
		chassis_forward = planned_forward * cos(relative_yaw) - planned_left * sin(relative_yaw)
		chassis_left = planned_forward * sin(relative_yaw) + planned_left * cos(relative_yaw)
	else:
		chassis_forward = planned_forward
		chassis_left = planned_left
	var wheel_speeds := [
		chassis_forward - chassis_left - chassis_yaw_velocity * CHASSIS_ROTATION_RADIUS,
		chassis_forward + chassis_left - chassis_yaw_velocity * CHASSIS_ROTATION_RADIUS,
		-chassis_forward + chassis_left - chassis_yaw_velocity * CHASSIS_ROTATION_RADIUS,
		-chassis_forward - chassis_left - chassis_yaw_velocity * CHASSIS_ROTATION_RADIUS]
	var max_wheel := 0.0
	for w in wheel_speeds:
		max_wheel = maxf(max_wheel, absf(w))
	if max_wheel > CHASSIS_WHEEL_SPEED_LIMIT:
		var scale := CHASSIS_WHEEL_SPEED_LIMIT / max_wheel
		planned_forward *= scale
		planned_right *= scale
		chassis_yaw_velocity *= scale
		robot["chassis_yaw_velocity"] = chassis_yaw_velocity

	var gimbal_world_yaw := _gimbal_world_yaw(robot)
	body.rotation.y = wrapf(body.rotation.y + chassis_yaw_velocity * delta, -PI, PI)
	# Keep within arena bounds.
	# Soft safety margin inside solid perimeter walls (~0.4m inset).
	body.position.x = clampf(body.position.x, -FIELD_HALF + 0.45, FIELD_HALF - 0.45)
	body.position.z = clampf(body.position.z, -FIELD_HALF + 0.45, FIELD_HALF - 0.45)
	var asm_yaw := 0.0
	if robot.has("assembly") and robot["assembly"] != null:
		asm_yaw = float(robot["assembly"].rotation.y)
	if not player_driving:
		# TANK MODE: lock gun to chassis. Muzzle == body forward == shell dir (both teams).
		yaw_axis.rotation.y = 0.0
		var pitch_lock: Node3D = robot["pitch_axis"]
		pitch_lock.rotation.x = 0.0
	else:
		var rel_y := wrapf(gimbal_world_yaw - body.rotation.y - asm_yaw, -PI, PI)
		yaw_axis.rotation.y = rel_y
	# Recompute basis AFTER yaw integrate so motion matches new nose (both teams).
	if not player_driving:
		forward = _body_forward_dir(robot)
		right = Vector3.UP.cross(forward)
		if right.length_squared() < 1e-6:
			right = Vector3.RIGHT
		else:
			right = right.normalized()
	var desired_velocity := forward * planned_forward + right * planned_right
	if not player_driving and not ai_rev_ok:
		var body_f := _body_forward_dir(robot)
		var along := desired_velocity.dot(body_f)
		if along < 0.0:
			desired_velocity -= body_f * along
		# Absolute ban on reverse planar velocity outside unstuck.
		if desired_velocity.dot(body_f) < 0.0:
			desired_velocity = right * planned_right
	body.velocity.x = desired_velocity.x
	body.velocity.z = desired_velocity.z
	if body.is_on_floor():
		body.velocity.y = 0.0
	else:
		body.velocity.y -= 20.0 * delta
	var pos_before := body.global_position
	body.move_and_slide()
	if not player_driving and ai_enabled:
		var moved := Vector3(body.global_position.x - pos_before.x, 0.0, body.global_position.z - pos_before.z).length()
		var cmd := absf(forward_input) + absf(right_input)
		var planar_spd := Vector3(body.velocity.x, 0.0, body.velocity.z).length()
		var wall_hit := false
		for si in range(body.get_slide_collision_count()):
			var colx := body.get_slide_collision(si)
			var nrm: Vector3 = colx.get_normal()
			nrm.y = 0.0
			if nrm.length_squared() > 1e-6 and absf(nrm.normalized().dot(forward)) > 0.55:
				wall_hit = true
				break
		if cmd > 0.35 and (moved < 0.012 * maxf(delta * 60.0, 1.0) or planar_spd < 0.12 or wall_hit):
			robot["ai_stuck_time"] = float(robot.get("ai_stuck_time", 0.0)) + delta
		else:
			robot["ai_stuck_time"] = maxf(0.0, float(robot.get("ai_stuck_time", 0.0)) - delta * 1.5)
		if float(robot.get("ai_stuck_time", 0.0)) > 0.35 and float(robot.get("ai_unstuck_t", 0.0)) <= 0.0:
			_begin_unstuck(robot, body, forward, right)
			robot["ai_stuck_time"] = 0.0



func _pick_ai_enemy(robot: Dictionary) -> Variant:
	## Sticky target with occasional retarget — reduces everyone chasing the same car.
	var sticky_id: int = int(robot.get("ai_target_id", -1))
	if sticky_id >= 0 and sticky_id < robots.size():
		var sticky: Dictionary = robots[sticky_id]
		if int(sticky["team"]) != int(robot["team"]) and bool(sticky.get("alive", true)):
			var d: float = robot["body"].global_position.distance_to(sticky["body"].global_position)
			if d < 11.0 and randf() > 0.015:
				return sticky
	# Weighted random among living enemies (favor nearer, not always nearest).
	var candidates: Array = []
	var weights: Array = []
	var my_pos: Vector3 = robot["body"].global_position
	var total_w := 0.0
	for other in robots:
		if int(other["team"]) == int(robot["team"]):
			continue
		if not bool(other.get("alive", true)):
			continue
		var dist: float = my_pos.distance_to(other["body"].global_position)
		var w: float = 1.0 / maxf(dist * dist, 0.8)
		# Slight preference for lower robot id variance by seed
		w *= 0.75 + 0.5 * absf(sin(float(other["id"] * 3 + robot["id"])))
		candidates.append(other)
		weights.append(w)
		total_w += w
	if candidates.is_empty():
		robot["ai_target_id"] = -1
		return null
	var r: float = randf() * total_w
	var acc := 0.0
	for i in range(candidates.size()):
		acc += float(weights[i])
		if r <= acc:
			robot["ai_target_id"] = int(candidates[i]["id"])
			return candidates[i]
	var last: Dictionary = candidates[candidates.size() - 1]
	robot["ai_target_id"] = int(last["id"])
	return last



func _shell_dodge_dir(robot: Dictionary) -> Vector3:
	## Escape sideways if an enemy shell is on a near-collision course.
	var body: CharacterBody3D = robot["body"]
	var my_pos: Vector3 = body.global_position
	my_pos.y = 0.0
	var best := Vector3.ZERO
	var best_urgency := 0.0
	for node in get_tree().get_nodes_in_group("sim_projectile"):
		if node == null or not is_instance_valid(node) or not (node is Node3D):
			continue
		var ot: Variant = node.get("owner_team")
		var owner_team: int = int(ot) if ot != null else -1
		if owner_team == int(robot["team"]):
			continue
		var v_var: Variant = node.get("velocity")
		if v_var == null:
			continue
		var v: Vector3 = v_var as Vector3
		v.y = 0.0
		if v.length_squared() < 1.0:
			continue
		var p: Vector3 = (node as Node3D).global_position
		p.y = 0.0
		var vdir := v.normalized()
		var to_me: Vector3 = my_pos - p
		var along: float = to_me.dot(vdir)
		if along < 0.15 or along > 9.0:
			continue
		var closest: Vector3 = p + vdir * along
		var miss: float = (my_pos - closest).length()
		if miss > 1.15:
			continue
		var speed: float = v.length()
		var tti: float = along / maxf(speed, 1.0)
		if tti > 0.85:
			continue
		var urgency: float = (1.0 - miss / 1.15) * (1.0 - tti / 0.85)
		var perp := Vector3(-vdir.z, 0.0, vdir.x)
		var left_clear := _clearance_score(body, perp)
		var right_clear := _clearance_score(body, -perp)
		var escape: Vector3 = perp if left_clear >= right_clear else -perp
		escape = escape * 0.85 - vdir * 0.25
		if escape.length_squared() > 1e-6:
			escape = escape.normalized()
		if urgency > best_urgency:
			best_urgency = urgency
			best = escape
	if best_urgency < 0.08:
		return Vector3.ZERO
	return best


func _clearance_score(body: CharacterBody3D, dir: Vector3) -> float:
	var d := dir
	d.y = 0.0
	if d.length_squared() < 1e-6:
		return 0.0
	d = d.normalized()
	var origin: Vector3 = body.global_position + Vector3(0.0, 0.28, 0.0)
	var space := get_world_3d().direct_space_state
	var query := PhysicsRayQueryParameters3D.create(origin, origin + d * 2.8)
	query.collide_with_bodies = true
	query.collide_with_areas = false
	query.collision_mask = 1
	query.exclude = [body.get_rid()]
	var hit := space.intersect_ray(query)
	if hit.is_empty():
		return 2.8
	return origin.distance_to(hit.get("position", origin))


func _pick_fire_opportunity(robot: Dictionary) -> Variant:
	## Only living enemies with CLEAR LOS (for aim+fire). Never same team.
	var best: Variant = null
	var best_score := -1e9
	var my_body: CharacterBody3D = robot["body"]
	var my_pos: Vector3 = my_body.global_position
	for other in robots:
		if int(other["team"]) == int(robot["team"]):
			continue
		if not bool(other.get("alive", true)):
			continue
		if not _enemy_visible(robot, other):
			continue  # cannot see → cannot be a fire target
		var op: Vector3 = other["body"].global_position + Vector3(0.0, 0.22, 0.0)
		var to_e: Vector3 = op - my_pos
		to_e.y = 0.0
		var dist: float = to_e.length()
		if dist < 0.7 or dist > MUZZLE_LINE_RANGE_MAX:
			continue
		var prefer: float = float(robot.get("ai_prefer_range", 2.4))
		var score: float = 5.0  # visible bonus
		score += 2.5 - absf(dist - prefer) * 0.4
		if int(other["id"]) == int(robot.get("ai_target_id", -1)):
			score += 0.8
		if score > best_score:
			best_score = score
			best = other
	return best


func _peek_shot_bias(robot: Dictionary, enemy: Variant) -> Vector3:
	## When LOS blocked, slide laterally around cover to create a firing lane.
	if enemy == null:
		return Vector3.ZERO
	var body: CharacterBody3D = robot["body"]
	var my_pos: Vector3 = body.global_position
	var epos: Vector3 = enemy["body"].global_position + Vector3(0.0, 0.22, 0.0)
	var eye: Vector3 = robot["pitch_axis"].global_position if robot.has("pitch_axis") else my_pos + Vector3(0, 0.25, 0)
	if not _ray_blocked(eye, epos, [body.get_rid(), enemy["body"].get_rid()]):
		var to_e: Vector3 = epos - my_pos
		to_e.y = 0.0
		if to_e.length_squared() < 1e-4:
			return Vector3.ZERO
		var side := Vector3(-to_e.z, 0.0, to_e.x).normalized()
		var orbit: float = float(robot.get("ai_orbit_dir", 1.0))
		return side * orbit * 0.35
	var to_e2: Vector3 = epos - my_pos
	to_e2.y = 0.0
	if to_e2.length_squared() < 1e-4:
		return Vector3.ZERO
	var dir := to_e2.normalized()
	var side2 := Vector3(-dir.z, 0.0, dir.x)
	var candidates: Array = [
		(dir * 0.35 + side2 * 0.9).normalized(),
		(dir * 0.35 - side2 * 0.9).normalized(),
		side2.normalized(),
		(-side2).normalized(),
		(dir * 0.15 + side2 * 1.1).normalized(),
		(dir * 0.15 - side2 * 1.1).normalized(),
	]
	var best_dir := Vector3.ZERO
	var best_s := -1.0
	for c in candidates:
		var probe_from: Vector3 = eye + c * 1.1
		var blocked := _ray_blocked(probe_from, epos, [body.get_rid(), enemy["body"].get_rid()])
		var clear := _clearance_score(body, c)
		var s: float = clear + (2.5 if not blocked else 0.0)
		if s > best_s:
			best_s = s
			best_dir = c
	return best_dir



func _update_ai_combat_mode(robot: Dictionary, delta: float, foe: Variant) -> void:
	## Break endless mutual barrage: after a short duel, one side disengages.
	var mode: String = str(robot.get("ai_mode", "hunt"))
	var aggression: float = clampf(float(robot.get("ai_aggression", 0.6)), 0.15, 1.2)
	var brave: float = clampf(float(robot.get("ai_brave", 0.5)), 0.1, 1.0)

	if mode == "disengage":
		robot["ai_disengage_t"] = float(robot.get("ai_disengage_t", 0.0)) - delta
		if float(robot["ai_disengage_t"]) <= 0.0:
			robot["ai_mode"] = "hunt"
			robot["ai_duel_t"] = 0.0
			robot["ai_shots_burst"] = 0
			var re: Variant = _nearest_enemy(robot)
			if re != null:
				robot["ai_target_id"] = int(re["id"])
		return

	if foe == null:
		robot["ai_duel_t"] = maxf(0.0, float(robot.get("ai_duel_t", 0.0)) - delta * 0.8)
		robot["ai_mode"] = "hunt"
		if float(robot.get("ai_duel_t", 0.0)) < 0.2:
			robot["ai_shots_burst"] = 0
		return

	var my_pos: Vector3 = robot["body"].global_position
	var epos: Vector3 = foe["body"].global_position
	var dist: float = my_pos.distance_to(epos)
	var eye: Vector3 = robot["pitch_axis"].global_position if robot.has("pitch_axis") else my_pos + Vector3(0, 0.25, 0)
	var tgt: Vector3 = epos + Vector3(0.0, 0.22, 0.0)
	var has_los := not _ray_blocked(eye, tgt, [robot["body"].get_rid(), foe["body"].get_rid()])
	var close_duel := dist < 4.8 and has_los

	# Incoming shells raise flee urgency
	var under_fire := _shell_dodge_dir(robot).length_squared() > 1e-4

	if close_duel or under_fire:
		robot["ai_duel_t"] = float(robot.get("ai_duel_t", 0.0)) + delta * (1.35 if under_fire else 1.0)
		robot["ai_mode"] = "engage"
	else:
		robot["ai_duel_t"] = maxf(0.0, float(robot.get("ai_duel_t", 0.0)) - delta * 0.55)
		if float(robot["ai_duel_t"]) < 0.35:
			robot["ai_mode"] = "hunt"
			robot["ai_shots_burst"] = 0

	# Threshold: low bravery / aggression breaks off sooner; also after burst volley.
	var threshold: float = 0.7 + brave * 1.4 + aggression * 1.1  # ~0.7–3.2 s
	# Asymmetry: even ids tend to disengage first in mirror duels
	if (int(robot["id"]) % 2) == 0:
		threshold *= 0.82
	else:
		threshold *= 1.12

	var burst: int = int(robot.get("ai_shots_burst", 0))
	var should_break := float(robot.get("ai_duel_t", 0.0)) >= threshold
	should_break = should_break or (burst >= 4 and randf() < 0.35 + (1.0 - brave) * 0.4)
	should_break = should_break or (under_fire and randf() < 0.08 + (1.0 - brave) * 0.12)

	if should_break and mode != "disengage" and float(robot.get("ai_hit_evade_t", 0.0)) <= 0.0:
		robot["ai_mode"] = "disengage"
		robot["ai_disengage_t"] = 0.35 + randf() * 0.45 + (1.0 - aggression) * 0.25
		robot["ai_shots_burst"] = 0
		robot["ai_duel_t"] = 0.0
		# Escape waypoint: away from enemy + lateral + toward cover/open space
		var away: Vector3 = my_pos - epos
		away.y = 0.0
		if away.length_squared() < 1e-4:
			away = _body_forward_dir(robot) * -1.0
		else:
			away = away.normalized()
		var side := Vector3(-away.z, 0.0, away.x) * (1.0 if randf() > 0.5 else -1.0)
		var esc: Vector3 = my_pos + away * (3.5 + randf() * 2.5) + side * (1.5 + randf() * 2.0)
		esc.x = clampf(esc.x, -6.5, 6.5)
		esc.z = clampf(esc.z, -6.5, 6.5)
		robot["ai_waypoint"] = esc
		robot["ai_want_sprint"] = true
		robot["ai_speed_scale"] = 1.0


func _compute_ai_drive(robot: Dictionary, delta: float) -> Vector2:
	## Asymmetric tactics + obstacle-aware pathing. Roles differ by robot id.
	var body: CharacterBody3D = robot["body"]
	var role: int = int(robot.get("ai_role", robot["id"] % 3))
	var nphase: float = float(robot.get("ai_noise_phase", 0.0))
	var nfreq: float = float(robot.get("ai_noise_freq", 0.8))
	var sgain: float = float(robot.get("ai_strafe_gain", 0.5))
	var aggression: float = clampf(float(robot.get("ai_aggression", 0.7)), 0.15, 1.15)
	var flank: float = float(robot.get("ai_flank", 1.0))
	var orbit: float = float(robot.get("ai_orbit_dir", 1.0))
	var prefer: float = float(robot.get("ai_prefer_range", 3.2))
	var style: float = float(robot.get("ai_style_seed", float(robot["id"])))

	# Periodic personality jitter (independent per car, not team-synced)
	robot["ai_repath_t"] = float(robot.get("ai_repath_t", 0.0)) - delta
	if float(robot["ai_repath_t"]) <= 0.0:
		robot["ai_repath_t"] = 1.6 + randf() * 3.8 + float(role) * 0.4
		if randf() < 0.42:
			robot["ai_orbit_dir"] = -orbit
			orbit = float(robot["ai_orbit_dir"])
		if randf() < 0.30:
			robot["ai_flank"] = -flank
			flank = float(robot["ai_flank"])
		if randf() < 0.28:
			robot["ai_prefer_range"] = clampf(prefer + randf_range(-0.5, 0.5), 1.5, 3.6)
			prefer = float(robot["ai_prefer_range"])
		if randf() < 0.18:
			robot["ai_aggression"] = clampf(aggression + randf_range(-0.18, 0.18), 0.2, 1.15)
			aggression = float(robot["ai_aggression"])
		# Full-arena hunt waypoint: go to enemy, anywhere on the field.
		var seek: Variant = _nearest_enemy(robot)
		if seek != null:
			var ep: Vector3 = seek["body"].global_position
			var to_e0: Vector3 = ep - body.global_position
			to_e0.y = 0.0
			var side_v := Vector3.RIGHT
			if to_e0.length_squared() > 1e-4:
				side_v = Vector3(-to_e0.z, 0.0, to_e0.x).normalized()
			# Mostly toward enemy; slight lateral only for approach angle.
			var lat := flank * orbit * (0.6 + float(role) * 0.35)
			var wp: Vector3 = ep + side_v * lat
			# If far, intermediate point across midfield so we leave own half.
			if to_e0.length() > 4.0:
				wp = body.global_position + to_e0.normalized() * minf(to_e0.length() * 0.55, 5.5)
				wp += side_v * lat * 0.5
			wp.x = clampf(wp.x, -FIELD_HALF + 0.9, FIELD_HALF - 0.9)
			wp.z = clampf(wp.z, -FIELD_HALF + 0.9, FIELD_HALF - 0.9)
			robot["ai_waypoint"] = wp
		else:
			# No enemy left: roam whole map center
			robot["ai_waypoint"] = Vector3(randf_range(-4.0, 4.0), 0.0, randf_range(-4.0, 4.0))

	var enemy: Variant = _pick_ai_enemy(robot)
	var body_fwd: Vector3 = _body_forward_dir(robot)
	var body_right: Vector3 = Vector3.UP.cross(body_fwd)
	if body_right.length_squared() < 1e-6:
		body_right = Vector3.RIGHT
	else:
		body_right = body_right.normalized()

	# Anti-camp: lingering in a small area → force rush nearest enemy.
	var camp_anchor: Vector3 = robot.get("ai_camp_anchor", body.global_position) as Vector3
	if body.global_position.distance_to(camp_anchor) > 3.2:
		robot["ai_camp_anchor"] = body.global_position
		robot["ai_camp_t"] = 0.0
	else:
		robot["ai_camp_t"] = float(robot.get("ai_camp_t", 0.0)) + delta
	if float(robot.get("ai_camp_t", 0.0)) > 1.6 and float(robot.get("ai_hit_evade_t", 0.0)) <= 0.0:
		var camp_foe: Variant = _nearest_enemy(robot)
		if camp_foe != null:
			var rush: Vector3 = camp_foe["body"].global_position - body.global_position
			rush.y = 0.0
			if rush.length_squared() > 0.2:
				rush = rush.normalized()
				robot["ai_camp_t"] = 1.5
				robot["ai_want_sprint"] = true
				robot["ai_speed_scale"] = 0.95
				robot["ai_mode"] = "hunt"
				return Vector2(
					clampf(body_fwd.dot(rush) * 1.3, 0.0, 1.0),
					clampf(body_right.dot(rush) * 0.9, -1.0, 1.0))

	# Highest priority: just got hit → scramble off the fire line.
	if float(robot.get("ai_hit_evade_t", 0.0)) > 0.0:
		robot["ai_hit_evade_t"] = float(robot["ai_hit_evade_t"]) - delta
		var wp_h: Vector3 = robot.get("ai_waypoint", Vector3.ZERO)
		var to_h: Vector3 = wp_h - body.global_position
		to_h.y = 0.0
		if to_h.length_squared() < 0.35:
			# Arrived pocket: keep strafing perpendicular to last shell
			var inn: Vector3 = robot.get("ai_hit_from", body_fwd) as Vector3
			inn.y = 0.0
			if inn.length_squared() > 1e-6:
				inn = inn.normalized()
			var side_h := Vector3(-inn.z, 0.0, inn.x)
			robot["ai_want_sprint"] = true
			robot["ai_speed_scale"] = 0.9
			return Vector2(0.2, clampf(body_right.dot(side_h) * 1.3, -1.0, 1.0))
		var hdir := to_h.normalized()
		var clear_h: Vector3 = _clearance_bias(body, hdir, body_right)
		hdir = (hdir * 0.4 + clear_h * 0.6).normalized()
		robot["ai_want_sprint"] = true
		robot["ai_speed_scale"] = 1.0
		return Vector2(
			clampf(body_fwd.dot(hdir) * 1.25, 0.1, 1.0),
			clampf(body_right.dot(hdir) * 1.3, -1.0, 1.0))

	# Next: dodge incoming enemy shells (sprint).
	var dodge: Vector3 = _shell_dodge_dir(robot)
	if dodge.length_squared() > 1e-4:
		robot["ai_want_sprint"] = true
		robot["ai_speed_scale"] = 1.0
		var f_d := clampf(body_fwd.dot(dodge) * 1.25, 0.0, 1.0)
		var r_d := clampf(body_right.dot(dodge) * 1.45, -1.0, 1.0)
		return Vector2(f_d, r_d)

	# Disengage / break contact: run to escape waypoint, don't stick and trade.
	if str(robot.get("ai_mode", "hunt")) == "disengage":
		var wp_e: Vector3 = robot.get("ai_waypoint", Vector3.ZERO)
		var to_esc: Vector3 = wp_e - body.global_position
		to_esc.y = 0.0
		if to_esc.length_squared() < 0.6:
			# Reached cover pocket: soft strafe
			robot["ai_want_sprint"] = false
			robot["ai_speed_scale"] = 0.4
			return Vector2(0.15, 0.55 * float(robot.get("ai_orbit_dir", 1.0)))
		var esc_dir := to_esc.normalized()
		var clear_e: Vector3 = _clearance_bias(body, esc_dir, body_right)
		esc_dir = (esc_dir * 0.45 + clear_e * 0.55).normalized()
		robot["ai_want_sprint"] = true
		robot["ai_speed_scale"] = 0.95
		var f_e := clampf(body_fwd.dot(esc_dir) * 1.2, 0.1, 1.0)
		var r_e := clampf(body_right.dot(esc_dir) * 1.15, -1.0, 1.0)
		return Vector2(f_e, r_e)

	var desired := Vector3.ZERO
	if enemy == null:
		# Wander toward own waypoint / open space
		var wp0: Vector3 = robot.get("ai_waypoint", Vector3.ZERO)
		var to_wp0: Vector3 = wp0 - body.global_position
		to_wp0.y = 0.0
		if to_wp0.length_squared() > 0.4:
			desired = to_wp0.normalized()
		else:
			desired = body_fwd * 0.3 + body_right * sin(sim_time * 0.5 + nphase)
	else:
		var to_enemy: Vector3 = enemy["body"].global_position - body.global_position
		to_enemy.y = 0.0
		var dist_e: float = to_enemy.length()
		var dir_to: Vector3 = to_enemy.normalized() if dist_e > 0.05 else body_fwd
		var lateral_dir: Vector3 = Vector3(-dir_to.z, 0.0, dir_to.x) * orbit

		var approach := 0.0
		if dist_e > prefer + 0.4:
			# Full-map chase: close hard until engagement range.
			approach = 0.95 + 0.25 * aggression
		elif dist_e > prefer:
			approach = 0.7 + 0.25 * aggression
		elif dist_e < prefer - 1.0:
			approach = 0.05  # hold ring by side-step, not reverse
		else:
			approach = 0.28 + 0.1 * sin(sim_time * nfreq + nphase)

		# Light flank only — stay aggressive, cross the whole arena.
		var flank_amt: float = (0.22 + 0.35 * sgain) * flank
		if role == 0:
			flank_amt *= 0.35
			approach = maxf(approach, 0.8)
		elif role == 2:
			flank_amt *= 1.1
			approach = maxf(approach, 0.65)

		desired = dir_to * approach + lateral_dir * flank_amt

		# Blend personal waypoint (breaks mirror formations)
		var wp: Vector3 = robot.get("ai_waypoint", Vector3.ZERO)
		var to_wp: Vector3 = wp - body.global_position
		to_wp.y = 0.0
		if to_wp.length_squared() > 0.25:
			var wpn := to_wp.normalized()
			var wp_w := 0.22 + 0.18 * float(role)  # flankers stick more to waypoints
			desired = desired * (1.0 - wp_w) + wpn * wp_w

		# Independent noise (phase/freq unique)
		desired += body_right * (sgain * 0.42 * sin(sim_time * nfreq + nphase + style))
		desired += body_fwd * (0.16 * cos(sim_time * (nfreq * 0.65) + nphase * 1.4 + style * 0.3))
		# If no LOS, slide to a peek angle to create a shot.
		var peek: Vector3 = _peek_shot_bias(robot, enemy)
		if peek.length_squared() > 1e-4:
			desired = desired * 0.55 + peek * 0.45

	desired.y = 0.0
	if desired.length_squared() < 1e-6:
		desired = body_fwd
	else:
		desired = desired.normalized()

	# Environment: strong free-space bias + peer separation
	var clear_bias: Vector3 = _clearance_bias(body, desired, body_right)
	desired = (desired * 0.72 + clear_bias * 0.28)  # prefer chase over local free-space camping
	desired.y = 0.0
	if desired.length_squared() > 1e-6:
		desired = desired.normalized()

	# Soft separation from teammates (prevents blob / mirror pile)
	var sep := Vector3.ZERO
	var my_pos: Vector3 = body.global_position
	for other in robots:
		if int(other["id"]) == int(robot["id"]):
			continue
		if not bool(other.get("alive", true)):
			continue
		var dvec: Vector3 = my_pos - other["body"].global_position
		dvec.y = 0.0
		var dlen: float = dvec.length()
		if dlen < 1.8 and dlen > 1e-3:
			var push: float = (1.8 - dlen) / 1.8
			if int(other["team"]) == int(robot["team"]):
				push *= 1.25  # stronger team separation
			sep += dvec.normalized() * push
	if sep.length_squared() > 1e-6:
		desired = (desired + sep.normalized() * 0.35)
		desired.y = 0.0
		if desired.length_squared() > 1e-6:
			desired = desired.normalized()

	var f_in: float = clampf(body_fwd.dot(desired) * (0.85 + 0.45 * aggression), 0.0, 1.0)
	var r_in: float = clampf(body_right.dot(desired) * (0.5 + sgain * 0.85), -1.0, 1.0)
	# If target is behind, turn hard instead of reversing.
	if body_fwd.dot(desired) < 0.15:
		f_in = maxf(f_in, 0.15)
		r_in = signf(body_right.dot(desired) if absf(body_right.dot(desired)) > 0.05 else float(robot.get("ai_orbit_dir", 1.0))) * maxf(absf(r_in), 0.8)
	r_in = clampf(r_in + 0.1 * sin(sim_time * (1.05 + nfreq) + nphase * 2.1 + style), -1.0, 1.0)
	# Role speed bias: rushers commit throttle
	if role == 0:
		f_in = clampf(f_in * 1.15, 0.0, 1.0)
	elif role == 2:
		r_in = clampf(r_in * 1.15, -1.0, 1.0)
		f_in = maxf(f_in, 0.25)
	# Variable speed: slow in hard turns, faster on straight approach/strafe
	var turn_amt: float = absf(r_in) / maxf(absf(f_in) + absf(r_in), 0.15)
	var speed_s := 0.55
	var mode_s: String = str(robot.get("ai_mode", "hunt"))
	if mode_s == "engage":
		speed_s = 0.62 + 0.2 * aggression
	else:
		speed_s = 0.48 + 0.25 * aggression
	# Turning → drop speed; pure forward → raise cruise
	speed_s *= lerpf(1.05, 0.35, clampf(turn_amt, 0.0, 1.0))
	if absf(f_in) > 0.7 and turn_amt < 0.35:
		speed_s = maxf(speed_s, 0.72)
	robot["ai_want_sprint"] = false
	robot["ai_speed_scale"] = clampf(speed_s, 0.12, 0.92)
	return Vector2(f_in, r_in)


func _clearance_bias(body: CharacterBody3D, desired: Vector3, right: Vector3) -> Vector3:
	## Prefer directions with more free space (7-ray cast over ~4m).
	var origin: Vector3 = body.global_position + Vector3(0.0, 0.28, 0.0)
	var space := get_world_3d().direct_space_state
	var best_dir: Vector3 = desired
	var best_score := -1.0
	var angles: Array = [-1.2, -0.75, -0.35, 0.0, 0.35, 0.75, 1.2]
	for a in angles:
		var dir: Vector3 = desired.rotated(Vector3.UP, float(a))
		dir.y = 0.0
		if dir.length_squared() < 1e-6:
			continue
		dir = dir.normalized()
		var query := PhysicsRayQueryParameters3D.create(origin, origin + dir * 4.2)
		query.collide_with_bodies = true
		query.collide_with_areas = false
		query.collision_mask = 1
		query.exclude = [body.get_rid()]
		var hit := space.intersect_ray(query)
		var score: float = 4.2
		if not hit.is_empty():
			var hp: Vector3 = hit.get("position", origin)
			score = origin.distance_to(hp)
		# prefer desired heading slightly; penalize walls hard
		score += 0.55 * maxf(0.0, dir.dot(desired))
		if score > best_score:
			best_score = score
			best_dir = dir
	return best_dir


func _nearest_enemy(robot: Dictionary) -> Variant:
	var best: Variant = null
	var best_d := INF
	var my_pos: Vector3 = robot["body"].global_position
	for other in robots:
		if int(other["team"]) == int(robot["team"]):
			continue
		if not bool(other["alive"]):
			continue
		var d: float = my_pos.distance_squared_to(other["body"].global_position)
		if d < best_d:
			best_d = d
			best = other
	return best


func _approach_speed(current: float, target: float, acceleration: float,
		deceleration: float, delta: float) -> float:
	var same_direction := is_zero_approx(current) or signf(current) == signf(target)
	var speeding_up := same_direction and absf(target) > absf(current)
	var rate := acceleration if speeding_up else deceleration
	return move_toward(current, target, rate * delta)


func _gimbal_world_yaw(robot: Dictionary) -> float:
	var asm_y := 0.0
	if robot.has("assembly") and robot["assembly"] != null:
		asm_y = float(robot["assembly"].rotation.y)
	return wrapf(robot["body"].rotation.y + asm_y + robot["yaw_axis"].rotation.y, -PI, PI)


func _update_robot_gimbal(robot: Dictionary, delta: float) -> void:
	var yaw_axis: Node3D = robot["yaw_axis"]
	var pitch_axis: Node3D = robot["pitch_axis"]
	var max_speed := 10.0
	var angle_kp := 14.0
	var speed_kp := 18.0
	var speed_ki := 2.0

	# AI: command_yaw is world heading for the whole vehicle (tank). Do not slew empty turret independently.
	if ai_enabled and bool(robot["auto_aim_enabled"]) and not (manual_control_mode and bool(robot.get("is_player", false))):
		var enemy_aim: Variant = _nearest_enemy(robot)
		if enemy_aim != null:
			var to_e: Vector3 = enemy_aim["body"].global_position - robot["body"].global_position
			to_e.y = 0.0
			if to_e.length_squared() > 1e-4:
				robot["command_yaw"] = _yaw_from_dir(to_e)
				robot["command_pitch"] = 0.0
		# Lock control axes to body; chassis turns to command_yaw.
		yaw_axis.rotation.y = 0.0
		pitch_axis.rotation.x = 0.0
		return

	if not bool(robot["auto_aim_enabled"]):
		robot["command_yaw"] = robot["manual_yaw_target"]
		robot["command_pitch"] = robot["manual_pitch_target"]
		robot["command_yaw_velocity"] = 0.0
		robot["command_yaw_acceleration"] = 0.0
		robot["command_pitch_velocity"] = 0.0
		robot["command_pitch_acceleration"] = 0.0

	var current_world_yaw := _gimbal_world_yaw(robot)
	var yaw_error := wrapf(float(robot["command_yaw"]) - current_world_yaw, -PI, PI)
	var yaw_velocity_feedforward := float(robot["command_yaw_velocity"]) * auto_aim_yaw_velocity_feedforward
	var desired_yaw_speed: float = clampf(yaw_error * angle_kp + yaw_velocity_feedforward, -max_speed, max_speed)
	var yaw_speed_error := desired_yaw_speed - float(robot["yaw_velocity"])
	robot["yaw_speed_integral"] = clampf(float(robot["yaw_speed_integral"]) + yaw_speed_error * delta, -4.0, 4.0)
	var yaw_accel := clampf(
		speed_kp * yaw_speed_error + speed_ki * float(robot["yaw_speed_integral"])
		+ float(robot["command_yaw_acceleration"]) * auto_aim_yaw_acceleration_feedforward,
		-planner_max_yaw_acc, planner_max_yaw_acc)
	robot["yaw_velocity"] = float(robot["yaw_velocity"]) + yaw_accel * delta
	var next_world_yaw := wrapf(current_world_yaw + float(robot["yaw_velocity"]) * delta, -PI, PI)
	var _asm_y2 := 0.0
	if robot.has("assembly") and robot["assembly"] != null:
		_asm_y2 = float(robot["assembly"].rotation.y)
	yaw_axis.rotation.y = wrapf(next_world_yaw - robot["body"].rotation.y - _asm_y2, -PI, PI)

	var pitch_error := float(robot["command_pitch"]) - pitch_axis.rotation.x
	var pitch_velocity_feedforward := float(robot["command_pitch_velocity"]) * auto_aim_pitch_velocity_feedforward
	var desired_pitch_speed: float = clampf(pitch_error * angle_kp + pitch_velocity_feedforward, -max_speed, max_speed)
	var pitch_speed_error := desired_pitch_speed - float(robot["pitch_velocity"])
	robot["pitch_speed_integral"] = clampf(float(robot["pitch_speed_integral"]) + pitch_speed_error * delta, -4.0, 4.0)
	var pitch_accel := clampf(
		speed_kp * pitch_speed_error + speed_ki * float(robot["pitch_speed_integral"])
		+ float(robot["command_pitch_acceleration"]) * auto_aim_pitch_acceleration_feedforward,
		-planner_max_pitch_acc, planner_max_pitch_acc)
	robot["pitch_velocity"] = float(robot["pitch_velocity"]) + pitch_accel * delta
	var next_pitch := pitch_axis.rotation.x + float(robot["pitch_velocity"]) * delta
	pitch_axis.rotation.x = clampf(next_pitch, -0.65, 0.65)
	if not is_equal_approx(next_pitch, pitch_axis.rotation.x):
		robot["pitch_velocity"] = 0.0
		robot["pitch_speed_integral"] = 0.0


func _update_robot_sensor_transform(robot: Dictionary) -> void:
	var pitch_axis: Node3D = robot["pitch_axis"]
	var sim_camera: Camera3D = robot["sim_camera"]
	# Keep vision camera on the gimbal; slight up/back offset avoids seeing own armor plate.
	var cam_xf := sensor_local_transform
	if sensor_local_transform == Transform3D.IDENTITY:
		cam_xf = Transform3D(Basis.IDENTITY, Vector3(0.0, 0.08, 0.05))
	sim_camera.global_transform = pitch_axis.global_transform * cam_xf
	if robot["is_player"] and player_camera != null:
		player_camera.transform = cam_xf


func _on_sensor_frame_pre_draw() -> void:
	if capture_requested_id < 0:
		return
	if pending_captures.has(capture_requested_id):
		return
	var robot: Dictionary = robots[capture_requested_id]
	var pitch_axis: Node3D = robot["pitch_axis"]
	var sim_camera: Camera3D = robot["sim_camera"]
	var camera_in_gimbal := pitch_axis.global_transform.affine_inverse() * sim_camera.global_transform
	var truth_target_world := Vector3.ZERO
	var truth_valid := false
	var enemy: Variant = _nearest_enemy(robot)
	if enemy != null:
		var armors: Array = enemy["armors"]
		if not armors.is_empty():
			var closest: Node3D = armors[0]
			var closest_d := pitch_axis.global_position.distance_squared_to(closest.global_position)
			for armor in armors:
				var d := pitch_axis.global_position.distance_squared_to(armor.global_position)
				if d < closest_d:
					closest = armor
					closest_d = d
			truth_target_world = closest.global_position - pitch_axis.global_position
			truth_valid = true
	pending_captures[capture_requested_id] = {
		"robot_id": capture_requested_id,
		"team": robot["team"],
		"gimbal_rotation": pitch_axis.global_transform.basis.get_rotation_quaternion(),
		"camera_in_gimbal": camera_in_gimbal,
		"fov": sim_camera.fov,
		"exposure": camera_exposure_multiplier,
		"gamma": camera_gamma,
		"truth_target_world": truth_target_world,
		"truth_valid": truth_valid,
		"timestamp_usec": Time.get_ticks_usec(),
		"bullet_speed": bullet_speed,
		"self_world": robot["body"].global_position,
	}


func _on_sensor_frame_post_draw() -> void:
	if capture_requested_id < 0:
		return
	var rid := capture_requested_id
	capture_requested_id = -1
	if not pending_captures.has(rid):
		return
	var capture: Dictionary = pending_captures[rid]
	pending_captures.erase(rid)
	if not extension_ready:
		return
	var robot: Dictionary = robots[rid]
	var image: Image = robot["viewport"].get_texture().get_image()
	if image == null or image.is_empty():
		return
	# SubViewport may return FORMAT_RGBA8; bridge accepts RGB8/RGBA8.
	bridge.submit_frame(
		int(capture["robot_id"]),
		int(capture["team"]),
		image,
		capture["gimbal_rotation"],
		capture["camera_in_gimbal"],
		capture["fov"],
		capture["exposure"],
		capture["gamma"],
		capture["truth_target_world"],
		capture["truth_valid"],
		capture["timestamp_usec"],
		capture["bullet_speed"],
		capture.get("self_world", robot["body"].global_position))
	robot["viewport"].render_target_update_mode = SubViewport.UPDATE_DISABLED


func _poll_all_results() -> void:
	for robot in robots:
		var rid: int = robot["id"]
		var result: Dictionary = bridge.poll_result(rid)
		if not result.get("ready", false):
			continue
		var capture_timestamp: int = int(result.get("capture_timestamp_usec", -1))
		if capture_timestamp < 0 or capture_timestamp <= int(robot["last_result_timestamp"]):
			continue
		robot["last_result_timestamp"] = capture_timestamp
		robot["result_count"] = int(robot["result_count"]) + 1
		robot["last_tracker_state"] = str(result.get("tracker_state", "?"))
		robot["last_armor_count"] = int(result.get("armor_count", 0))
		robot["last_total_ms"] = float(result.get("total_ms", 0.0))
		if int(robot["last_armor_count"]) > 0:
			robot["detection_count"] = int(robot["detection_count"]) + 1
		if bool(result.get("control", false)):
			robot["control_count"] = int(robot["control_count"]) + 1
		if bool(result.get("fusion_valid", false)):
			robot["fusion_valid_count"] = int(robot["fusion_valid_count"]) + 1
		var nb: int = int(result.get("fusion_neighbor_count", 0))
		robot["last_fusion_neighbors"] = nb
		if nb > int(robot["fusion_neighbor_count_max"]):
			robot["fusion_neighbor_count_max"] = nb
		if bool(result.get("fusion_used_neighbors", false)) and str(result.get("tracker_state", "")).begins_with("fusion_assist"):
			robot["fusion_assist_count"] = int(robot["fusion_assist_count"]) + 1

		# Vision yaw only for manual player — AI tank uses geometry aim (fixes blue flip).
		if bool(robot["auto_aim_enabled"]) and bool(result.get("control", false)):
			var is_manual_bot := manual_control_mode and bool(robot.get("is_player", false))
			if is_manual_bot:
				robot["command_yaw"] = result.get("yaw_rad", robot["command_yaw"])
				robot["command_pitch"] = -float(result.get("pitch_rad", -float(robot["command_pitch"])))
				robot["command_yaw_velocity"] = float(result.get("yaw_velocity_rad_s", 0.0))
				robot["command_yaw_acceleration"] = float(result.get("yaw_acceleration_rad_s2", 0.0))
				robot["command_pitch_velocity"] = -float(result.get("pitch_velocity_rad_s", 0.0))
				robot["command_pitch_acceleration"] = -float(result.get("pitch_acceleration_rad_s2", 0.0))

		# Geometry aim for AI; vision yaw only for manual player.


func _update_hud() -> void:
	if hud_label == null:
		return
	var vp_size: Vector2 = get_viewport().get_visible_rect().size
	# Center reticle for video aim
	if aim_reticle != null:
		aim_reticle.position = Vector2(vp_size.x * 0.5 - 12.0, vp_size.y * 0.5 - 22.0)
		aim_reticle.visible = true
	if aim_status_label != null:
		aim_status_label.position = Vector2(vp_size.x * 0.5 - 120.0, vp_size.y * 0.5 + 18.0)
		aim_status_label.size = Vector2(240, 28)

	var lines: PackedStringArray = []
	var stats := {}
	if extension_ready and bridge != null:
		stats = bridge.get_runtime_stats()
	var view_name := "俯视(旋转/缩放)" if overview_mode else "第一人称"
	lines.append("3v3 online=%s  view=%s  距离=%.1fm  方位=%.0f°  俯仰=%.0f°" % [
		str(extension_ready), view_name, orbit_distance,
		rad_to_deg(orbit_yaw), rad_to_deg(orbit_pitch),
	])
	var mode_txt := "自动(全车AI)" if not manual_control_mode else "手动(操控选中车)"
	var focus_txt := "—"
	if not robots.is_empty():
		focus_txt = _robot_label(robots[player_robot_id])
	lines.append("操控模式: %s  |  焦点车: %s  |  T切换  1-6选车  手动时WASD+Space" % [mode_txt, focus_txt])
	var hit_sum := "被击中: "
	for hr in robots:
		var tg := "红" if int(hr["team"]) == TEAM_RED else "蓝"
		var nn := int(hr.get("number", int(hr["id"]) % ROBOTS_PER_TEAM + 1))
		var tk := int(hr.get("hit_taken", 0))
		var st := ("(----)已击毁" if not bool(hr.get("alive", true)) else str(tk))
		hit_sum += "%s%d:%s  " % [tg, nn, st]
	lines.append(hit_sum)
	if match_over:
		lines.append("★★ %s ★★" % match_result_text)
	lines.append("vision submitted=%s processed=%s dropped=%s queue=%s" % [
		str(stats.get("submitted", 0)), str(stats.get("processed", 0)),
		str(stats.get("dropped", 0)), str(stats.get("queue_depth", 0)),
	])

	var red_hits := 0
	var blue_hits := 0
	var red_shots := 0
	var blue_shots := 0
	for robot in robots:
		var team_tag := "R" if int(robot["team"]) == TEAM_RED else "B"
		var num := int(robot.get("number", int(robot["id"]) % ROBOTS_PER_TEAM + 1))
		var mark := "*" if bool(robot["is_player"]) else " "
		var shots_i := int(robot["shots"])
		var hits_i := int(robot["hits"])
		var rate := (100.0 * float(hits_i) / float(shots_i)) if shots_i > 0 else 0.0
		var aiming := "自瞄"
		if manual_control_mode and bool(robot["is_player"]):
			aiming = "手动"
		elif bool(robot["auto_aim_enabled"]):
			aiming = "自瞄"
		else:
			aiming = "手动"
		var tracker := str(robot["last_tracker_state"])
		var fire_flag := ""
		if bool(robot.get("manual_fire_pressed", false)):
			fire_flag = " 开火中"
		elif auto_fire_all and bool(robot.get("auto_aim_enabled", true)) and tracker == "tracking":
			fire_flag = " 可开火"
		var taken_i := int(robot.get("hit_taken", 0))
		if bool(robot.get("alive", true)):
			lines.append("%s%s%d [%s] 被击中:%d/%d%s | 发射%d 命中敌%d" % [
				mark, team_tag, num, aiming,
				taken_i, ARMOR_HP, fire_flag,
				shots_i, hits_i,
			])
		else:
			lines.append("%s%s%d  (----)已击毁  累计被击中:%d" % [
				mark, team_tag, num, taken_i,
			])
		if int(robot["team"]) == TEAM_RED:
			red_hits += hits_i
			red_shots += shots_i
		else:
			blue_hits += hits_i
			blue_shots += shots_i

	var red_rate := (100.0 * float(red_hits) / float(red_shots)) if red_shots > 0 else 0.0
	var blue_rate := (100.0 * float(blue_hits) / float(blue_shots)) if blue_shots > 0 else 0.0
	var total_shots := red_shots + blue_shots
	var total_hits := red_hits + blue_hits
	var total_rate := (100.0 * float(total_hits) / float(total_shots)) if total_shots > 0 else 0.0
	lines.append("SCORE 红队 发射%d 命中%d 率%.1f%% | 蓝队 发射%d 命中%d 率%.1f%% | 全场 发射%d 命中%d 率%.1f%% | t=%.1fs" % [
		red_shots, red_hits, red_rate, blue_shots, blue_hits, blue_rate,
		total_shots, total_hits, total_rate, sim_time,
	])
	hud_label.text = "\n".join(lines)

	if not robots.is_empty():
		var pr: Dictionary = robots[player_robot_id]
		var p_shots := int(pr.get("shots", 0))
		var p_hits := int(pr.get("hits", 0))
		var p_rate := (100.0 * float(p_hits) / float(p_shots)) if p_shots > 0 else 0.0
		var aim_on := bool(pr.get("auto_aim_enabled", false))
		var tracker := str(pr.get("last_tracker_state", "—"))
		var team_name := "红" if int(pr.get("team", 0)) == TEAM_RED else "蓝"
		var arm_n := int(pr.get("last_armor_count", 0))
		# Video-aim status under crosshair
		if aim_status_label != null:
			var aim_txt := "视频瞄准: "
			if tracker == "tracking":
				aim_txt += "锁定中"
				aim_status_label.add_theme_color_override("font_color", Color(0.2, 1.0, 0.3))
				if aim_reticle != null:
					aim_reticle.add_theme_color_override("font_color", Color(0.15, 1.0, 0.25))
			elif tracker.contains("detect") or tracker == "detecting":
				aim_txt += "检测中"
				aim_status_label.add_theme_color_override("font_color", Color(1.0, 0.9, 0.2))
				if aim_reticle != null:
					aim_reticle.add_theme_color_override("font_color", Color(1.0, 0.85, 0.15))
			else:
				aim_txt += tracker
				aim_status_label.add_theme_color_override("font_color", Color(1.0, 0.4, 0.35))
				if aim_reticle != null:
					aim_reticle.add_theme_color_override("font_color", Color(1.0, 0.35, 0.3))
			if aim_on:
				aim_txt += " | 自瞄"
			else:
				aim_txt += " | 手动"
			if arm_n > 0:
				aim_txt += " | 目标x%d" % arm_n
			aim_status_label.text = aim_txt

		if combat_hud_label != null:
			var combat := PackedStringArray()
			combat.append("════ 操控 / 射击统计 ════")
			combat.append("全局模式: %s" % ("自动(全车AI)" if not manual_control_mode else "手动操控"))
			combat.append("焦点车辆: %s%d%s" % [
				team_name, int(pr.get("number", 1)),
				" [操作中]" if manual_control_mode else " [仅观察]",
			])
			combat.append("瞄准: %s" % ("自瞄" if aim_on else "手动"))
			combat.append("视频跟踪: %s" % tracker)
			combat.append("装甲检测: %d" % arm_n)
			combat.append("融合邻机: %d" % int(pr.get("last_fusion_neighbors", 0)))
			combat.append("手动开火(Space/J): %s" % (
				"是" if bool(pr.get("manual_fire_pressed", false)) else "否"))
			combat.append("AI开火: %s (仅炮管直线有敌)" % ("开" if auto_fire_all else "关"))
			combat.append("提示: T切换自动/手动 | 1-6选车")
			combat.append("────────────")
			combat.append("发射总数:  %d" % p_shots)
			combat.append("命中数:    %d" % p_hits)
			combat.append("命中率:    %.1f%%" % p_rate)
			combat.append("────────────")
			combat.append("【PK】红存活%d 蓝存活%d | 命中分 红%d 蓝%d | 剩余%.0fs" % [
				_team_alive_count(TEAM_RED), _team_alive_count(TEAM_BLUE),
